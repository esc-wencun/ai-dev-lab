# Docker 环境变量（本文件刻意提交入库：全部为公开的本地开发默认值，无真实凭据）。
# 修改端口/密码/内存上限等值后执行 docker compose up -d 生效；换数据库名需 down -v 重置。

# ---- MySQL 8.0 ----
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=111111
MYSQL_DATABASE=ry-vue
MYSQL_USER=wencun
MYSQL_PASSWORD=111111

# ---- Redis Stack（含向量/搜索模块）----
REDIS_PORT=16379
REDIS_PASSWORD=111111

# 内存上限与淘汰策略：
# 作为向量库/搜索用建议 noeviction（写满报错，不丢数据）；
# 纯缓存用可改为 allkeys-lru
REDIS_MAXMEMORY=512mb
REDIS_EVICTION=noeviction
