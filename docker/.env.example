# Docker 环境变量模板
# 复制本文件为 docker/.env 即可覆盖下方默认值；不复制则使用内置默认值。
# docker/.env 与本文件内容一致且同样提交入库（全部为公开的本地开发默认值，无真实凭据）。

# ---- MySQL 8.0 ----
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=111111
MYSQL_DATABASE=ry-vue
MYSQL_USER=wencun
MYSQL_PASSWORD=111111

# ---- Redis Stack（含向量/搜索模块）----
REDIS_PORT=16379
REDIS_PASSWORD=111111

# 内存上限与淘汰策略：
# 作为向量库/搜索用建议 noeviction（写满报错，不丢数据）；
# 纯缓存用可改为 allkeys-lru
REDIS_MAXMEMORY=512mb
REDIS_EVICTION=noeviction
