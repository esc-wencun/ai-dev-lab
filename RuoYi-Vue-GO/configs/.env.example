# RuoYi-Vue-GO 配置模板：复制为 .env.dev 后按需修改
# 数据库/Redis/token 的值以 Java 版 RuoYi-Vue 的 application.yml 为准手动同步

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=ry-vue
DB_ECHO=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

APP_PORT=8080
APP_MODE=debug

TOKEN_HEADER=Authorization
TOKEN_SECRET=
TOKEN_EXPIRE_MINUTES=30

CAPTCHA_TYPE=math
