# 数据库配置（本地 Docker MySQL，与 Java/Python 版共用；.env.dev 不提交 git）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=wencun
DB_PASSWORD=111111
DB_DATABASE=ry-vue
DB_ECHO=false

# Redis 配置（本地 Docker Redis，与 Java/Python 版共用）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=111111
REDIS_DATABASE=0

# 应用配置（三版互斥：同一时间只能运行一个，见 AGENTS.md）
APP_PORT=8080
APP_MODE=debug

# token 配置（对位 Java application.yml token 段，secret 必须与 Java 一致）
TOKEN_HEADER=Authorization
TOKEN_SECRET=abcdefghijklmnopqrstuvwxyz
TOKEN_EXPIRE_MINUTES=30

# 验证码配置
CAPTCHA_TYPE=math
