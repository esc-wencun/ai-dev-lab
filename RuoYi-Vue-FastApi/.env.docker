# 本地 Docker 环境配置（配合根目录 docker/docker-compose.yml 使用）
# 用法：cd RuoYi-Vue-FastApi && python app.py --env=docker
# 与 docker/.env.example 中的默认密码保持一致，如修改 docker/.env 请同步此处。

# 数据库配置（连接本地 Docker MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=wencun
DB_PASSWORD=111111
DB_DATABASE=ry-vue
DB_ECHO=false

# Redis 配置（连接本地 Docker Redis）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=111111
REDIS_DATABASE=0

# 应用配置
APP_PORT=8080
APP_RELOAD=true
